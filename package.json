{
  "name": "mapa-cmf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n servidor,cliente -c blue,green \"npm:dev:servidor\" \"npm:dev:cliente\"",
    "dev:servidor": "node --watch --import tsx src/servidor/index.ts",
    "dev:cliente": "vite",
    "build": "vite build",
    "test": "vitest run",
    "tipos": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "formatar": "biome check --write .",
    "verificar": "npm run tipos && npm run lint && npm run test",
    "bd:gerar": "drizzle-kit generate",
    "importar": "tsx scripts/importar.ts",
    "geocodificar": "tsx scripts/geocodificar.ts",
    "start": "tsx src/servidor/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "read-excel-file": "^9.3.10",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
