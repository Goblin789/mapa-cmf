# Copiar para .env (que nunca vai para o git). Ver docs/m1.md ("Variáveis de ambiente").
# As variáveis do ambiente (ou da linha de comando) têm prioridade sobre o .env.
# Pasta com os Excel de origem (só lida, nunca escrita).
PASTA_ORIGEM=C:\Users\Kr4ke\CMF S.àr.l\Rafael\MAPA CMF
# Ficheiro da base de dados local (no Render: o disco persistente, ex.: /var/data/mapa.db).
BD=dados/mapa.db
# Porta do servidor. O Render define PORT, que tem prioridade sobre PORTA.
PORTA=8787
# Onde o servidor escuta. Omissão: 0.0.0.0 em produção, 127.0.0.1 fora dela. Sem login é sempre 127.0.0.1.
HOST=
# NODE_ENV=production só no Render (em produção o servidor não arranca sem login).

# --- Login Microsoft (Entra), aplicação "Mapa CMF" ---
# Com os três preenchidos o servidor entra no modo "entra" (tudo exige sessão); sem o segredo fica local.
# Directory (tenant) ID e Application (client) ID: não são segredos.
ENTRA_INQUILINO=
ENTRA_CLIENTE=
# Segredo da aplicação (Entra > Certificates & secrets). Nunca no git nem no chat.
ENTRA_SEGREDO=
# Origem pública, sem barra no fim: URI de retorno, verificação da origem, cookie Secure e HSTS.
# Ex.: https://mapa.cmf-lux.lu (produção) ou http://localhost:5173 (login no PC, com o Vite).
# O npm run publicar -- --esperar só a usa se for https público (no PC é o localhost): senão --endereco.
ENDERECO_PUBLICO=
# Outros nomes aceites no cabeçalho Host, separados por vírgulas (ex.: mapa-cmf.onrender.com). As páginas
# abertas por estes nomes vão para ENDERECO_PUBLICO (só lá funciona o login).
ANFITRIOES=
# E-mails de quem pode entrar, separados por vírgulas: segunda barreira além da atribuição no Entra.
# Obrigatória em produção. Tirar um e-mail e reiniciar termina logo as sessões dessa pessoa.
UTILIZADORES_PERMITIDOS=
# Só para testes com o fornecedor falso (npm run login-falso); recusado em produção.
ENTRA_EMISSOR=

# --- Cópias de segurança ---
# Segredo: 32 bytes em base64 (npm run copias -- chave). Guardar também no gestor de palavras-passe.
COPIAS_CHAVE=
# "s3" ou "pasta:dados/copias-teste". Sem ela não há cópias automáticas.
# No PC, depois da 1.ª publicação, deixar comentada (#) e usar em COPIAS_S3_ID e COPIAS_S3_SEGREDO o token R2
# de LEITURA (Object Read only); o de escrita fica só no Render (docs/publicar.md, passos 2 e 4). Fora de
# produção o servidor nunca escreve num destino s3 (é o balde da produção); npm run copias usa-o sempre.
COPIAS_DESTINO=
# Destino S3 compatível (Cloudflare R2, UE). ID e SEGREDO são segredos.
COPIAS_S3_ENDPOINT=
COPIAS_S3_BALDE=
COPIAS_S3_REGIAO=
COPIAS_S3_ID=
COPIAS_S3_SEGREDO=
# Se a BD não existir ao arrancar, restaura esta cópia ("ultima" ou o nome). Nunca substitui uma BD que exista.
# "nenhuma" = começar de propósito com uma BD vazia. Sem ela, se a BD faltar e já houver cópias, não arranca.
RESTAURAR_AO_ARRANCAR=

# --- Publicação ---
# Segredo: npm run publicar usa-o para pedir uma publicação ao Render.
RENDER_DEPLOY_HOOK=
